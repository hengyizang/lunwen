{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/semantic-plan.schema.json",
  "title": "Read-only Claude semantic plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "objectives",
    "artifact_specs",
    "evidence_requirements",
    "figure_specs",
    "risks",
    "open_questions"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "stage": {"type": "string"},
    "objectives": {"type": "array"},
    "artifact_specs": {"type": "array"},
    "evidence_requirements": {"type": "array"},
    "figure_specs": {"type": "array"},
    "risks": {"type": "array"},
    "open_questions": {"type": "array"}
  }
}
