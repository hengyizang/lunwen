{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/economic-data-request.schema.json",
  "title": "Conditional source-bound economic data request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "provider", "scope", "as_of", "vintage_mode", "start", "end", "max_pages", "page_size"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "provider": {"enum": ["fred", "worldbank"]},
    "scope": {"enum": ["metadata_only", "observations"]},
    "as_of": {"type": "string", "format": "date"},
    "vintage_mode": {"enum": ["snapshot_as_of", "retrieval_snapshot"]},
    "start": {"type": "string", "format": "date"},
    "end": {"type": "string", "format": "date"},
    "max_pages": {"type": "integer", "minimum": 1, "maximum": 20},
    "page_size": {"type": "integer", "minimum": 1, "maximum": 1000},
    "dataset_manifest": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^data/manifests/[a-z0-9][a-z0-9._-]*\\.json$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "series": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"},
          "units": {"type": "string", "minLength": 1, "maxLength": 300},
          "frequency": {"type": "string", "minLength": 1, "maxLength": 300},
          "seasonal_adjustment": {"type": "string", "minLength": 1, "maxLength": 300}
        }}
    },
    "countries": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z]{3}$"}},
    "indicators": {"type": "array", "minItems": 1, "maxItems": 10,
      "items": {"type": "object", "additionalProperties": false, "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"},
          "unit": {"type": "string", "maxLength": 300}
        }}}
  },
  "allOf": [
    {"if": {"properties": {"provider": {"const": "fred"}}},
      "then": {"required": ["series"], "properties": {"vintage_mode": {"const": "snapshot_as_of"}},
        "not": {"anyOf": [{"required": ["countries"]}, {"required": ["indicators"]}]}},
      "else": {"required": ["countries", "indicators"], "properties": {"vintage_mode": {"const": "retrieval_snapshot"}}, "not": {"required": ["series"]}}},
    {"if": {"properties": {"scope": {"const": "observations"}}},
      "then": {"required": ["dataset_manifest"], "properties": {
        "series": {"items": {"required": ["units", "frequency", "seasonal_adjustment"]}},
        "indicators": {"items": {"required": ["unit"]}}
      }}, "else": {"not": {"required": ["dataset_manifest"]}}}
  ]
}
