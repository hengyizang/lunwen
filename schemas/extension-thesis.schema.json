{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/extension-thesis.schema.json",
  "title": "Independent doctoral extension theme B",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "theme_id", "status", "title", "doctoral_question", "distinct_contribution", "mechanism_or_rationale", "novelty_claim_ids", "planned_paper_ids", "independent_evidence_plan", "falsification_conditions", "boundary_conditions", "relationship_to_core", "fallback_if_unsupported", "human_review_required"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "theme_id": {"const": "B"},
    "status": {"enum": ["ready_for_review", "approved"]},
    "title": {"type": "string", "minLength": 1},
    "doctoral_question": {"type": "string", "minLength": 1},
    "distinct_contribution": {"type": "string", "minLength": 1},
    "mechanism_or_rationale": {"type": "string", "minLength": 1},
    "novelty_claim_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "planned_paper_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^P[0-9]{2}$"}},
    "independent_evidence_plan": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "falsification_conditions": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "boundary_conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "relationship_to_core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shared_foundation", "independent_question", "independent_claims", "independent_primary_evidence", "survives_core_failure", "non_dependency_rationale"],
      "properties": {
        "shared_foundation": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "independent_question": {"const": true},
        "independent_claims": {"const": true},
        "independent_primary_evidence": {"const": true},
        "survives_core_failure": {"const": true},
        "non_dependency_rationale": {"type": "string", "minLength": 1}
      }
    },
    "fallback_if_unsupported": {"type": "string", "minLength": 1},
    "human_review_required": {"const": true}
  }
}
