{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/manual-citation-verifications.schema.json",
  "title": "Human citation verification records",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["verified_by", "verified_at", "source_url", "title"],
    "properties": {
      "verified_by": {"type": "string", "minLength": 1},
      "verified_at": {"type": "string", "format": "date-time"},
      "source_url": {"type": "string", "pattern": "^https://"},
      "title": {"type": "string", "minLength": 1},
      "notes": {"type": "string"}
    }
  }
}
