{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit literature discovery scope and heuristic ranking plan",
  "type": "object",
  "required": [
    "schema_version",
    "doctoral_question",
    "topic_keywords"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "doctoral_question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "topic_keywords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclude_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_requests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "cache_max_age_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30
    },
    "searches": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "provider",
          "query"
        ],
        "properties": {
          "provider": {
            "enum": [
              "openalex",
              "crossref",
              "semantic-scholar",
              "arxiv",
              "europe-pmc",
              "dblp",
              "hal"
            ]
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "query_family": {
            "type": "string"
          },
          "date_range": {
            "type": [
              "string",
              "object"
            ]
          },
          "filters": {
            "type": [
              "string",
              "object"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    "conferences": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "venue",
          "year"
        ],
        "properties": {
          "venue": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "enrich_limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "transport": {"enum": ["search", "sparql"]},
          "fallback": {
            "description": "Optional separate bounded alternate source when DBLP is unavailable. Venue is an exact container label checked against every accepted record. It never establishes complete DBLP enumeration.",
            "oneOf": [
              {"const": false},
              {"type": "object", "additionalProperties": false, "required": ["provider", "venue"],
               "properties": {"provider": {"enum": ["crossref", "openalex"]}, "venue": {"type": "string", "minLength": 1, "maxLength": 300}}}
            ]
          }
        }
      }
    },
    "receipts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string"
      }
    },
    "ranking_weights": {
      "type": "object",
      "description": "Discovery priorities only. Reviewed feedback proposals may adjust these without deciding scientific inclusion or novelty.",
      "additionalProperties": false,
      "properties": {
        "topic_relevance": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "recency": {"type": "number", "minimum": 0, "maximum": 10},
        "citation_visibility": {"type": "number", "minimum": 0, "maximum": 10},
        "abstract_rhetoric": {"type": "number", "minimum": 0, "maximum": 10},
        "interest_feedback": {"type": "number", "minimum": 0, "maximum": 10}
      }
    },
    "feedback": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "interest",
          "reason",
          "recorded_by",
          "recorded_at"
        ],
        "description": "Legacy explicit reading-interest preferences. Multi-dimensional observed feedback belongs to immutable reports/literature-feedback events and requires a reviewed proposal for adoption.",
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "interest": {"enum": ["interested", "not_interested", "neutral"]},
          "reason": {"type": "string", "minLength": 1},
          "recorded_by": {"type": "string", "minLength": 1},
          "recorded_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
