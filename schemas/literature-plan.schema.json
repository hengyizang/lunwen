{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit literature discovery scope and heuristic ranking plan",
  "type": "object",
  "required": [
    "schema_version",
    "doctoral_question",
    "topic_keywords"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "doctoral_question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "topic_keywords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclude_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_requests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "cache_max_age_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30
    },
    "searches": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "provider",
          "query"
        ],
        "properties": {
          "provider": {
            "enum": [
              "openalex",
              "crossref",
              "semantic-scholar",
              "arxiv",
              "europe-pmc",
              "dblp",
              "hal"
            ]
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "query_family": {
            "type": "string"
          },
          "date_range": {
            "type": [
              "string",
              "object"
            ]
          },
          "filters": {
            "type": [
              "string",
              "object"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    "conferences": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "venue",
          "year"
        ],
        "properties": {
          "venue": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "enrich_limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          }
        }
      }
    },
    "receipts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string"
      }
    },
    "ranking_weights": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      }
    },
    "feedback": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "interest",
          "reason",
          "recorded_by",
          "recorded_at"
        ]
      }
    }
  }
}
