{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/quality-gate.schema.json",
  "title": "Doctoral Research OS quality gate report",
  "type": "object",
  "required": [
    "schema_version",
    "gate",
    "status",
    "evidence",
    "novelty_claim",
    "feasibility_claim",
    "scientific_contribution",
    "novelty_basis",
    "novelty_is_absence_only",
    "originality_assessment",
    "doctoral_readiness",
    "blockers",
    "human_review_required"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.1",
        "1.2"
      ]
    },
    "gate": {
      "enum": [
        "G1",
        "G2",
        "G3",
        "G4",
        "G5"
      ]
    },
    "status": {
      "enum": [
        "ready_for_review",
        "approved"
      ]
    },
    "scores": {
      "description": "Optional numerical self-scores are observations, never a scientific pass threshold."
    },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "claim_supported",
          "source_date"
        ]
      }
    },
    "novelty_claim": {
      "type": "string",
      "minLength": 1
    },
    "feasibility_claim": {
      "type": "string",
      "minLength": 1
    },
    "scientific_contribution": {
      "type": "string",
      "minLength": 1
    },
    "novelty_basis": {
      "enum": [
        "comparative_primary_literature",
        "comparative_literature_and_patents"
      ]
    },
    "novelty_is_absence_only": {
      "const": false
    },
    "originality_assessment": {
      "type": "object",
      "required": [
        "closest_prior_work_ids",
        "adjacent_fields_checked",
        "non_novel_elements",
        "differentiating_claims",
        "counterevidence_considered",
        "residual_risk"
      ],
      "properties": {
        "closest_prior_work_ids": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "adjacent_fields_checked": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "non_novel_elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "differentiating_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "counterevidence_considered": {
          "const": true
        },
        "residual_risk": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "doctoral_readiness": {
      "type": "object",
      "required": [
        "unifying_thesis",
        "original_knowledge_contribution",
        "synthesis_beyond_individual_papers",
        "methodological_progression",
        "scope_boundaries",
        "examiner_challenges"
      ],
      "properties": {
        "unifying_thesis": {
          "type": "string",
          "minLength": 1
        },
        "original_knowledge_contribution": {
          "type": "string",
          "minLength": 1
        },
        "synthesis_beyond_individual_papers": {
          "type": "string",
          "minLength": 1
        },
        "methodological_progression": {
          "type": "string",
          "minLength": 1
        },
        "scope_boundaries": {
          "type": "string",
          "minLength": 1
        },
        "examiner_challenges": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "venue_readiness": {
      "description": "Optional early venue notes are advisory; verify the actual selected venue at submission packaging."
    },
    "blockers": {
      "type": "array",
      "maxItems": 0
    },
    "human_review_required": {
      "type": "boolean"
    },
    "assessments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "rationale",
          "source_anchors"
        ],
        "properties": {
          "status": {
            "enum": [
              "satisfied",
              "unresolved",
              "failed"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "source_anchors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256",
                "locator",
                "excerpt"
              ]
            }
          }
        }
      },
      "properties": {
        "venue_fit": {
          "description": "Optional observational criterion; any actual source anchor remains subject to factual integrity checks."
        },
        "publication_potential": {
          "description": "Optional observational criterion; any actual source anchor remains subject to factual integrity checks."
        },
        "english_academic_writing": {
          "description": "Optional observational criterion; any actual source anchor remains subject to factual integrity checks."
        }
      }
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.2"
          }
        }
      },
      "then": {
        "required": [
          "assessments"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "gate": {
            "enum": [
              "G1",
              "G2"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "human_review_required": {
            "const": true
          }
        }
      }
    }
  ]
}
