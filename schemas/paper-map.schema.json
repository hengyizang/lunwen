{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/paper-map.schema.json",
  "title": "Doctoral paper portfolio map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "papers",
    "thesis_synthesis"
  ],
  "allOf": [{"if": {"properties": {"independence_basis": {"const": "cumulative"}}, "required": ["independence_basis"]}, "then": {"properties": {"thesis_synthesis": {"required": ["cumulative_contributions"]}}}, "else": {"required": ["pairwise_distinctness"]}}],
  "properties": {
    "independence_basis": {"enum": ["cumulative", "legacy_pairwise"], "description": "New portfolios use one cumulative evidence/contribution row per paper. Existing approved pairwise records remain readable."},
    "schema_version": {
      "const": "2.0"
    },
    "status": {
      "enum": [
        "ready_for_review",
        "approved"
      ]
    },
    "papers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paper_id",
          "theme_id",
          "portfolio_role",
          "distinct_contribution",
          "unique_claim_ids",
          "shared_assets",
          "dependencies"
        ],
        "properties": {
          "paper_id": {
            "type": "string",
            "pattern": "^P[0-9]{2}$"
          },
          "theme_id": {
            "enum": [
              "A",
              "B"
            ]
          },
          "target_jcr_quartile": {
            "description": "Optional planning observation; absence or unknown never supplies a scientific gate or venue floor. Preserve the user's existing target.",
            "enum": [
              "Q1",
              "Q2",
              "Q3",
              "Q4",
              "unknown",
              null
            ]
          },
          "portfolio_role": {
            "type": "string",
            "minLength": 1
          },
          "distinct_contribution": {
            "type": "string",
            "minLength": 1
          },
          "unique_claim_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "shared_assets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "pairwise_distinctness": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paper_a",
          "paper_b",
          "distinct_research_questions",
          "distinct_primary_claims",
          "independent_primary_evidence",
          "standalone_scientific_value",
          "shared_primary_outcome",
          "shared_outcome_justification",
          "overlap_risk",
          "why_separate",
          "merge_trigger"
        ],
        "properties": {
          "paper_a": {
            "type": "string",
            "pattern": "^P[0-9]{2}$"
          },
          "paper_b": {
            "type": "string",
            "pattern": "^P[0-9]{2}$"
          },
          "distinct_research_questions": {
            "const": true
          },
          "distinct_primary_claims": {
            "const": true
          },
          "independent_primary_evidence": {
            "const": true
          },
          "standalone_scientific_value": {
            "const": true
          },
          "shared_primary_outcome": {
            "type": "boolean"
          },
          "shared_outcome_justification": {
            "type": "string",
            "minLength": 1
          },
          "overlap_risk": {
            "enum": [
              "low",
              "moderate"
            ]
          },
          "why_separate": {
            "type": "string",
            "minLength": 1
          },
          "merge_trigger": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "thesis_synthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_thesis",
        "extension_thesis",
        "cumulative_progression",
        "integrated_contribution",
        "dependency_logic",
        "argument_links"
      ],
      "properties": {
        "cumulative_contributions": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "additionalProperties": false,
            "required": ["paper_id", "claim_ids", "knowledge_increment", "primary_evidence", "standalone_value", "merge_trigger"],
            "properties": {
              "paper_id": {"type": "string", "pattern": "^P[0-9]{2}$"},
              "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "knowledge_increment": {"type": "string", "minLength": 1},
              "primary_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "standalone_value": {"type": "string", "minLength": 1},
              "merge_trigger": {"type": "string", "minLength": 1}
            }
          }
        },
        "core_thesis": {
          "type": "string",
          "minLength": 1
        },
        "extension_thesis": {
          "type": "string",
          "minLength": 1
        },
        "cumulative_progression": {
          "type": "string",
          "minLength": 1
        },
        "integrated_contribution": {
          "type": "string",
          "minLength": 1
        },
        "dependency_logic": {
          "type": "string",
          "minLength": 1
        },
        "argument_links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_id",
              "claim_ids",
              "contribution",
              "what_changes_if_unsupported"
            ],
            "properties": {
              "step_id": {
                "type": "string",
                "minLength": 1
              },
              "claim_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "contribution": {
                "type": "string",
                "minLength": 1
              },
              "what_changes_if_unsupported": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "evidence_alignment": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_id",
              "result_status",
              "comparison_ids",
              "claim_matrix_sha256",
              "evidence_plan_sha256",
              "disposition",
              "claim_boundary"
            ],
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "result_status": {
                "enum": [
                  "supported",
                  "partially_supported",
                  "not_supported",
                  "contradicted",
                  "inconclusive"
                ]
              },
              "comparison_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "claim_matrix_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "evidence_plan_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "disposition": {
                "enum": [
                  "retain",
                  "narrow",
                  "reframe",
                  "unsupported"
                ]
              },
              "claim_boundary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
