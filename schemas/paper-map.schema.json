{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/paper-map.schema.json",
  "title": "Doctoral paper portfolio map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "papers", "pairwise_distinctness", "thesis_synthesis"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "status": {"enum": ["ready_for_review", "approved"]},
    "papers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paper_id", "portfolio_role", "distinct_contribution", "unique_claim_ids", "shared_assets", "dependencies"],
        "properties": {
          "paper_id": {"type": "string", "pattern": "^P[0-9]{2}$"},
          "portfolio_role": {"type": "string", "minLength": 1},
          "distinct_contribution": {"type": "string", "minLength": 1},
          "unique_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "shared_assets": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "pairwise_distinctness": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paper_a", "paper_b", "distinct_research_questions", "distinct_primary_claims", "independent_primary_evidence", "standalone_scientific_value", "shared_primary_outcome", "shared_outcome_justification", "overlap_risk", "why_separate", "merge_trigger"],
        "properties": {
          "paper_a": {"type": "string", "pattern": "^P[0-9]{2}$"},
          "paper_b": {"type": "string", "pattern": "^P[0-9]{2}$"},
          "distinct_research_questions": {"const": true},
          "distinct_primary_claims": {"const": true},
          "independent_primary_evidence": {"const": true},
          "standalone_scientific_value": {"const": true},
          "shared_primary_outcome": {"type": "boolean"},
          "shared_outcome_justification": {"type": "string", "minLength": 1},
          "overlap_risk": {"enum": ["low", "moderate"]},
          "why_separate": {"type": "string", "minLength": 1},
          "merge_trigger": {"type": "string", "minLength": 1}
        }
      }
    },
    "thesis_synthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_thesis", "extension_thesis", "cumulative_progression", "integrated_contribution", "dependency_logic"],
      "properties": {
        "core_thesis": {"type": "string", "minLength": 1},
        "extension_thesis": {"type": "string", "minLength": 1},
        "cumulative_progression": {"type": "string", "minLength": 1},
        "integrated_contribution": {"type": "string", "minLength": 1},
        "dependency_logic": {"type": "string", "minLength": 1}
      }
    }
  }
}
