{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/dataset-manifest.schema.json",
  "title": "Dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "title",
    "provider",
    "source_url",
    "version",
    "accessed_at",
    "license",
    "download",
    "provenance",
    "unit_of_analysis",
    "split_strategy",
    "known_limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "doi": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "accessed_at": {
      "type": "string",
      "format": "date"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "research_use_allowed",
        "redistribution_allowed",
        "confirmed_by_human"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "research_use_allowed": {
          "type": "boolean"
        },
        "redistribution_allowed": {
          "type": "boolean"
        },
        "confirmed_by_human": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256",
        "expected_bytes"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^([a-fA-F0-9]{64}|pending)$"
        },
        "expected_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "filename": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "collection_method",
        "transformations"
      ],
      "properties": {
        "collection_method": {
          "type": "string"
        },
        "transformations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "unit_of_analysis": {
      "type": "string"
    },
    "split_strategy": {
      "type": "string"
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "papers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^P[0-9]{2}$"
      }
    }
  }
}

