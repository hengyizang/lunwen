{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "anchor": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "locator",
        "excerpt"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        },
        "pdf_page": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "idea": {
      "type": "object",
      "required": [
        "hypothesis_id",
        "hypothesis",
        "source_observation",
        "precise_difference",
        "prediction",
        "falsifying_result",
        "null_result_value",
        "source_anchors",
        "alternative_explanations",
        "failure_modes",
        "test_plan",
        "novelty_status",
        "evidence_status"
      ],
      "properties": {
        "hypothesis_id": {
          "type": "string",
          "minLength": 1
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "source_observation": {
          "type": "string",
          "minLength": 1
        },
        "precise_difference": {
          "type": "string",
          "minLength": 1
        },
        "prediction": {
          "type": "string",
          "minLength": 1
        },
        "falsifying_result": {
          "type": "string",
          "minLength": 1
        },
        "null_result_value": {
          "type": "string",
          "minLength": 1
        },
        "source_anchors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/anchor"
          }
        },
        "alternative_explanations": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "explanation",
              "discriminating_test",
              "expected_if_true"
            ],
            "properties": {
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "discriminating_test": {
                "type": "string",
                "minLength": 1
              },
              "expected_if_true": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "failure_modes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "test_plan": {
          "type": "object",
          "required": [
            "comparator",
            "metric",
            "dataset",
            "cloud_execution",
            "budget_cny",
            "deadline",
            "controls"
          ],
          "properties": {
            "comparator": {
              "type": "string",
              "minLength": 1
            },
            "metric": {
              "type": "string",
              "minLength": 1
            },
            "dataset": {
              "type": "string",
              "minLength": 1
            },
            "cloud_execution": {
              "type": "string",
              "minLength": 1
            },
            "deadline": {
              "type": "string",
              "minLength": 1
            },
            "controls": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "budget_cny": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "novelty_status": {
          "const": "prior_art_search_required"
        },
        "evidence_status": {
          "const": "hypothesis"
        }
      }
    }
  },
  "title": "Source-bound paper card",
  "required": [
    "schema_version",
    "paper_id",
    "research_question",
    "claimed_contribution",
    "source_scope",
    "methods_assessed",
    "experiments_assessed",
    "claim_evidence",
    "candidate_ideas"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "claimed_contribution": {
      "type": "string",
      "minLength": 1
    },
    "source_scope": {
      "enum": [
        "full_text",
        "abstract",
        "excerpt",
        "metadata"
      ]
    },
    "methods_assessed": {
      "type": "boolean"
    },
    "experiments_assessed": {
      "type": "boolean"
    },
    "claim_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim",
          "boundary",
          "attribution",
          "anchor"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          },
          "attribution": {
            "enum": [
              "author_statement",
              "agent_analysis"
            ]
          },
          "anchor": {
            "$ref": "#/$defs/anchor"
          }
        }
      }
    },
    "candidate_ideas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/idea"
      }
    },
    "primary_source": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "scope_record": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_scope": {
            "const": "full_text"
          }
        }
      },
      "then": {
        "required": [
          "primary_source",
          "scope_record"
        ]
      }
    }
  ]
}
