{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/paper-contract.schema.json",
  "title": "Doctoral paper contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "paper_id", "writing_language", "working_title", "research_question", "distinct_contribution", "relationship_to_core", "relationship_to_extension", "originality_boundary", "hypotheses", "datasets", "planned_experiments", "falsification_conditions", "dependencies", "independence", "target_venues", "status"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "paper_id": {"type": "string", "pattern": "^P[0-9]{2}$"},
    "writing_language": {"const": "en"},
    "working_title": {"type": "string", "minLength": 1},
    "research_question": {"type": "string", "minLength": 1},
    "distinct_contribution": {"type": "string", "minLength": 1},
    "relationship_to_core": {"type": "string", "minLength": 1},
    "relationship_to_extension": {"type": "string", "minLength": 1},
    "originality_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["novel_elements", "reused_elements", "closest_prior_work_ids", "differentiation", "claim_limitations"],
      "properties": {
        "novel_elements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "reused_elements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "closest_prior_work_ids": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "differentiation": {"type": "string", "minLength": 1},
        "claim_limitations": {"type": "string", "minLength": 1}
      }
    },
    "hypotheses": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "statement", "null_hypothesis", "confirmatory", "primary_outcome"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "null_hypothesis": {"type": "string", "minLength": 1},
          "confirmatory": {"type": "boolean"},
          "primary_outcome": {"type": "string", "minLength": 1}
        }
      }
    },
    "datasets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "planned_experiments": {
      "type": "object", "additionalProperties": false,
      "required": ["design_ids", "baseline_classes", "ablations", "primary_evaluation", "statistical_plan", "external_validity_plan", "reproducibility_plan"],
      "properties": {
        "design_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "baseline_classes": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["simple", "domain_standard", "strong_recent"]}},
        "ablations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "primary_evaluation": {"type": "string", "minLength": 1},
        "statistical_plan": {"type": "string", "minLength": 1},
        "external_validity_plan": {"type": "string", "minLength": 1},
        "reproducibility_plan": {"type": "string", "minLength": 1}
      }
    },
    "falsification_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "independence": {
      "type": "object", "additionalProperties": false,
      "required": ["unique_claim_ids", "shared_assets", "overlap_with_other_papers", "why_not_merge"],
      "properties": {
        "unique_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "shared_assets": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "overlap_with_other_papers": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "why_not_merge": {"type": "string", "minLength": 1}
      }
    },
    "target_venues": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "quartile", "indexing", "category", "jcr_year", "source_url", "scope_fit", "article_type"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "quartile": {"const": "Q1"},
          "indexing": {"enum": ["SCI", "SCIE"]},
          "category": {"type": "string", "minLength": 1},
          "jcr_year": {"type": "integer", "minimum": 2000},
          "source_url": {"type": "string", "pattern": "^https://"},
          "scope_fit": {"type": "string", "minLength": 1},
          "article_type": {"type": "string", "minLength": 1}
        }
      }
    },
    "status": {"enum": ["draft", "ready_for_review", "approved", "retired"]}
  }
}
