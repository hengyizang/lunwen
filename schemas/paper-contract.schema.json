{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/paper-contract.schema.json",
  "title": "Paper contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_id",
    "working_title",
    "research_question",
    "distinct_contribution",
    "relationship_to_core",
    "relationship_to_extension",
    "hypotheses",
    "datasets",
    "experiments",
    "falsification_conditions",
    "dependencies",
    "target_venues",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "paper_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}$"
    },
    "working_title": {
      "type": "string"
    },
    "research_question": {
      "type": "string"
    },
    "distinct_contribution": {
      "type": "string"
    },
    "relationship_to_core": {
      "type": "string"
    },
    "relationship_to_extension": {
      "type": "string"
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "falsification_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_venues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "draft",
        "ready_for_review",
        "approved",
        "retired"
      ]
    }
  }
}

