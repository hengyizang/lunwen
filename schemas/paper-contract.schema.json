{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/paper-contract.schema.json",
  "title": "Doctoral paper contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_id",
    "writing_language",
    "target_jcr_quartile",
    "working_title",
    "research_question",
    "distinct_contribution",
    "relationship_to_core",
    "relationship_to_extension",
    "cloud_feasibility",
    "originality_boundary",
    "hypotheses",
    "datasets",
    "planned_experiments",
    "falsification_conditions",
    "dependencies",
    "independence",
    "target_venues",
    "status",
    "negative_result_plan",
    "scientific_bindings",
    "dependency_bindings"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "paper_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}$"
    },
    "writing_language": {
      "const": "en"
    },
    "target_jcr_quartile": {
      "enum": [
        "Q1",
        "Q2"
      ]
    },
    "working_title": {
      "type": "string",
      "minLength": 1
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "distinct_contribution": {
      "type": "string",
      "minLength": 1
    },
    "relationship_to_core": {
      "type": "string",
      "minLength": 1
    },
    "relationship_to_extension": {
      "type": "string",
      "minLength": 1
    },
    "cloud_feasibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_paper_cloud_executable",
        "no_future_lab_dependency",
        "data_access_plan",
        "cloud_execution_plan",
        "evidence_and_claim_scope"
      ],
      "properties": {
        "current_paper_cloud_executable": {
          "type": "boolean"
        },
        "no_future_lab_dependency": {
          "type": "boolean"
        },
        "data_access_plan": {
          "type": "string"
        },
        "cloud_execution_plan": {
          "type": "string"
        },
        "evidence_and_claim_scope": {
          "type": "string"
        }
      }
    },
    "originality_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "novel_elements",
        "reused_elements",
        "closest_prior_work_ids",
        "differentiation",
        "claim_limitations"
      ],
      "properties": {
        "novel_elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reused_elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "closest_prior_work_ids": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "differentiation": {
          "type": "string",
          "minLength": 1
        },
        "claim_limitations": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "null_hypothesis",
          "confirmatory",
          "primary_outcome"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "null_hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "confirmatory": {
            "type": "boolean"
          },
          "primary_outcome": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "planned_experiments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_ids",
        "baseline_classes",
        "ablations",
        "primary_evaluation",
        "statistical_plan",
        "external_validity_plan",
        "reproducibility_plan"
      ],
      "properties": {
        "design_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "baseline_classes": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "enum": [
              "simple",
              "domain_standard",
              "strong_recent"
            ]
          }
        },
        "ablations": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "primary_evaluation": {
          "type": "string",
          "minLength": 1
        },
        "statistical_plan": {
          "type": "string",
          "minLength": 1
        },
        "external_validity_plan": {
          "type": "string",
          "minLength": 1
        },
        "reproducibility_plan": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "falsification_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unique_claim_ids",
        "shared_assets",
        "overlap_with_other_papers",
        "why_not_merge"
      ],
      "properties": {
        "unique_claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shared_assets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "overlap_with_other_papers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "why_not_merge": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target_venues": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "quartile",
          "indexing",
          "category",
          "jcr_year",
          "source_url",
          "scope_fit",
          "article_type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "quartile": {
            "enum": [
              "Q1",
              "Q2"
            ]
          },
          "indexing": {
            "enum": [
              "SCI",
              "SCIE"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "jcr_year": {
            "type": "integer",
            "minimum": 2000
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "scope_fit": {
            "type": "string",
            "minLength": 1
          },
          "article_type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "ready_for_review",
        "approved",
        "retired"
      ]
    },
    "empirical_workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data_contract_ids": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,100}$"
          }
        },
        "causal_design": {
          "type": "boolean"
        },
        "reporting": {
          "type": "boolean"
        },
        "economic_request_ids": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,100}$"
          }
        }
      }
    },
    "study_route": {
      "enum": [
        "empirical",
        "meta_analysis",
        "theory"
      ]
    },
    "negative_result_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "informative_if_unsupported",
        "precision_limitations",
        "stop_rule",
        "claim_boundary"
      ],
      "properties": {
        "informative_if_unsupported": {
          "type": "string",
          "minLength": 1
        },
        "precision_limitations": {
          "type": "string",
          "minLength": 1
        },
        "stop_rule": {
          "type": "string",
          "minLength": 1
        },
        "claim_boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scientific_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "hypotheses",
        "falsification_conditions"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hypothesis_id",
              "primary_outcome_statement",
              "primary_metric",
              "direction",
              "aggregation",
              "decision_rule",
              "minimum_effect",
              "condition_ids",
              "rationale"
            ],
            "properties": {
              "hypothesis_id": {
                "type": "string",
                "minLength": 1
              },
              "primary_outcome_statement": {
                "type": "string",
                "minLength": 1
              },
              "primary_metric": {
                "type": "string",
                "minLength": 1
              },
              "direction": {
                "enum": [
                  "higher",
                  "lower"
                ]
              },
              "aggregation": {
                "type": "string",
                "minLength": 1
              },
              "decision_rule": {
                "enum": [
                  "superiority",
                  "equivalence"
                ]
              },
              "minimum_effect": {
                "type": "number",
                "minimum": 0
              },
              "condition_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "falsification_conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "condition_id",
              "hypothesis_id",
              "statement",
              "metric",
              "decision_rule",
              "threshold",
              "rationale"
            ],
            "properties": {
              "condition_id": {
                "type": "string",
                "minLength": 1
              },
              "hypothesis_id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "decision_rule": {
                "enum": [
                  "superiority",
                  "equivalence"
                ]
              },
              "threshold": {
                "type": "number",
                "minimum": 0
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "dependency_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paper_id",
          "kind",
          "claim_ids",
          "graph_id",
          "node_ids",
          "rationale",
          "inherited_scope"
        ],
        "properties": {
          "paper_id": {
            "type": "string",
            "pattern": "^P[0-9]{2}$"
          },
          "kind": {
            "enum": [
              "scientific_premise",
              "shared_asset"
            ]
          },
          "claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "graph_id": {
            "type": "string",
            "minLength": 1
          },
          "node_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "inherited_scope": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "study_route"
        ],
        "properties": {
          "study_route": {
            "enum": [
              "meta_analysis",
              "theory"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "hypotheses": {
            "minItems": 1
          },
          "datasets": {
            "minItems": 1
          },
          "planned_experiments": {
            "properties": {
              "baseline_classes": {
                "minItems": 3
              },
              "ablations": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "study_route"
        ],
        "properties": {
          "study_route": {
            "const": "theory"
          }
        }
      },
      "then": {
        "properties": {
          "datasets": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
