{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/data-quality-report.schema.json",
  "title": "Local hash-bound dataset quality report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "created_at", "generated_by", "source_path", "derived_data", "manifest_download_sha256", "canonical_hash_match", "inventory", "tabular_profile", "optional_upstreams", "blockers", "warnings", "initiated_by", "human_review_required", "status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "created_at": {"type": "string", "format": "date-time"},
    "generated_by": {"const": "deterministic_local_control_plane"},
    "source_path": {"type": "string", "minLength": 1},
    "derived_data": {"type": "boolean"},
    "manifest_download_sha256": {"type": "string"},
    "canonical_hash_match": {"type": "boolean"},
    "inventory": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "tabular_profile": {"type": ["object", "null"]},
    "optional_upstreams": {"type": "object"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "initiated_by": {"type": "string", "minLength": 1},
    "human_review_required": {"const": true},
    "status": {"enum": ["pass", "block"]}
  }
}
