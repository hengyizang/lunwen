{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Separate reviewer experiment scope; proposal grants no authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "paper_id", "round_id", "scope_id", "comment_ids", "comment_dispositions", "analysis_phase", "prior_outcomes_seen", "rationale", "outcome_access_statement", "scope_and_claim_limits", "imports", "original_plan_sha256", "original_preregistration_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "paper_id": {"type": "string", "pattern": "^P[0-9]{2}$"},
    "round_id": {"type": "string", "pattern": "^R[0-9]{3}$"},
    "scope_id": {"type": "string", "pattern": "^s[0-9]{3}$"},
    "comment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "comment_dispositions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["comment_id", "requires_experiment", "rationale"], "properties": {"comment_id": {"type": "string"}, "requires_experiment": {"type": "boolean"}, "rationale": {"type": "string", "minLength": 10}}}},
    "analysis_phase": {"enum": ["exploratory", "prospective_followup"]},
    "prior_outcomes_seen": {"const": true},
    "rationale": {"type": "string", "minLength": 10},
    "outcome_access_statement": {"type": "string", "minLength": 10},
    "scope_and_claim_limits": {"type": "string", "minLength": 10},
    "imports": {"type": "array", "maxItems": 1000, "items": {"type": "object", "additionalProperties": false, "required": ["source", "target", "sha256"], "properties": {"source": {"type": "string"}, "target": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "original_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "original_preregistration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
