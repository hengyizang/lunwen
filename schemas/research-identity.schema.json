{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Original research identity, not scientific certification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_id",
    "research_kind",
    "design_family",
    "methods",
    "reporting_description",
    "new_analysis_rationale",
    "validation_plan",
    "claim_ids",
    "secondary_protocol",
    "venue_classifications",
    "analysis_evidence",
    "reporting_statement"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "paper_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}$"
    },
    "research_kind": {
      "enum": [
        "unassigned",
        "primary",
        "secondary_quantitative"
      ]
    },
    "design_family": {
      "enum": [
        "unassigned",
        "empirical",
        "computational",
        "theoretical",
        "case-study",
        "policy",
        "software",
        "meta-analysis",
        "quantitative-reanalysis",
        "bibliometric-hypothesis-test"
      ]
    },
    "methods": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "reporting_description": {
      "type": "string",
      "maxLength": 250
    },
    "new_analysis_rationale": {
      "type": "string",
      "maxLength": 5000
    },
    "validation_plan": {
      "type": "string",
      "maxLength": 5000
    },
    "claim_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "secondary_protocol": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "question",
            "input_selection",
            "data_extraction",
            "comparability",
            "bias_and_dependence",
            "estimand",
            "analysis_method",
            "uncertainty",
            "robustness",
            "added_knowledge",
            "cloud_execution"
          ],
          "properties": {
            "question": {
              "type": "string",
              "minLength": 40,
              "maxLength": 5000
            },
            "input_selection": {
              "type": "string",
              "minLength": 40,
              "maxLength": 5000
            },
            "data_extraction": {
              "type": "string",
              "minLength": 40,
              "maxLength": 5000
            },
            "comparability": {
              "type": "string",
              "minLength": 40,
              "maxLength": 5000
            },
            "bias_and_dependence": {
              "type": "string",
              "minLength": 40,
              "maxLength": 5000
            },
            "estimand": {
              "type": "string",
              "minLength": 40,
              "maxLength": 5000
            },
            "analysis_method": {
              "type": "string",
              "minLength": 40,
              "maxLength": 5000
            },
            "uncertainty": {
              "type": "string",
              "minLength": 40,
              "maxLength": 5000
            },
            "robustness": {
              "type": "string",
              "minLength": 40,
              "maxLength": 5000
            },
            "added_knowledge": {
              "type": "string",
              "minLength": 40,
              "maxLength": 5000
            },
            "cloud_execution": {
              "type": "string",
              "minLength": 40,
              "maxLength": 5000
            }
          }
        }
      ]
    },
    "venue_classifications": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "venue_name",
          "article_type",
          "official_url",
          "checked_at",
          "research_article_eligible",
          "design_eligible",
          "rationale",
          "evidence"
        ],
        "properties": {
          "venue_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "article_type": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "official_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "research_article_eligible": {
            "type": "boolean"
          },
          "design_eligible": {
            "type": "boolean"
          },
          "rationale": {
            "type": "string",
            "minLength": 60,
            "maxLength": 5000
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "start_line",
              "end_line",
              "quote"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^evidence/"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 10,
                "maxLength": 4000
              }
            }
          }
        }
      }
    },
    "analysis_evidence": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_id",
          "path",
          "sha256"
        ],
        "properties": {
          "attempt_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "reporting_statement": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "excerpt",
            "location"
          ],
          "properties": {
            "excerpt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            "location": {
              "type": "object"
            }
          }
        }
      ]
    }
  }
}
