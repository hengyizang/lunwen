{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owner-requested cloud research job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action", "project", "actor", "allow_paid"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "action": {"enum": ["preflight", "acceptance", "init", "status", "cycle", "paperqa", "tooluniverse"]},
    "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "actor": {"type": "string", "minLength": 1, "maxLength": 100},
    "allow_paid": {"type": "boolean"},
    "paper_count": {"type": "integer", "minimum": 1, "maximum": 20},
    "context": {"type": "string", "maxLength": 4000},
    "stage": {"enum": ["intake", "topic-intelligence", "paper-architecture", "experiment-design", "experiment-execution", "writing-and-review"]},
    "corpus": {"type": "string", "maxLength": 250},
    "question": {"type": "string", "minLength": 1, "maxLength": 2000},
    "settings": {"enum": ["fast", "medium", "high"]},
    "request_file": {"type": "string", "maxLength": 250}
  }
}
