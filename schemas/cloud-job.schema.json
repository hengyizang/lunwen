{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owner-requested cloud research job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action",
    "project",
    "actor",
    "allow_paid"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "action": {
      "enum": [
        "preflight",
        "acceptance",
        "free_jev_probe",
        "bocha_jev_probe",
        "init",
        "status",
        "authorize_budget",
        "reconcile_budget",
        "cycle",
        "continuation",
        "paperqa",
        "tooluniverse",
        "authorize_data",
        "resume",
        "review_dossier",
        "ready",
        "approve",
        "advance",
        "reopen",
        "freeze_preregistration",
        "confirm_data_quality",
        "confirm_reproduction",
        "screen_literature",
        "confirm_source_scope"
      ]
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "allow_paid": {
      "type": "boolean"
    },
    "live": {
      "type": "boolean"
    },
    "free_policy_checked_on": {
      "type": "string",
      "format": "date"
    },
    "new_ceiling_cny": {
      "type": "integer",
      "minimum": 300,
      "multipleOf": 300
    },
    "reservation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "actual_cost_cny": {
      "type": "number",
      "minimum": 0
    },
    "evidence_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "paper_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "context": {
      "type": "string",
      "maxLength": 4000
    },
    "stage": {
      "enum": [
        "intake",
        "topic-intelligence",
        "paper-architecture",
        "experiment-design",
        "experiment-execution",
        "writing-and-review"
      ]
    },
    "corpus": {
      "type": "string",
      "maxLength": 250
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "settings": {
      "enum": [
        "fast",
        "medium",
        "high"
      ]
    },
    "request_file": {
      "type": "string",
      "maxLength": 250
    },
    "manifest": {
      "type": "string",
      "pattern": "^data/manifests/.+\\.json$"
    },
    "expected_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repair_note": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "operation": {
      "enum": [
        "ready",
        "approve",
        "advance",
        "reopen",
        "freeze_preregistration",
        "confirm_data_quality",
        "confirm_reproduction",
        "screen_literature",
        "confirm_source_scope"
      ]
    },
    "gate": {
      "enum": [
        "G0",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5"
      ]
    },
    "paper_id": {
      "type": "string",
      "pattern": "^(P[0-9]{2}|all)$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,100}$"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250
    },
    "scope": {
      "enum": [
        "full_text",
        "abstract",
        "excerpt",
        "metadata"
      ]
    },
    "note": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "included_work_ids": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "exclusion_reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "ready"
          }
        }
      },
      "then": {
        "required": [
          "gate",
          "expected_sha256",
          "note"
        ],
        "properties": {
          "allow_paid": {
            "const": false
          }
        },
        "not": {
          "required": [
            "operation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "approve"
          }
        }
      },
      "then": {
        "required": [
          "gate",
          "expected_sha256",
          "note"
        ],
        "properties": {
          "allow_paid": {
            "const": false
          }
        },
        "not": {
          "required": [
            "operation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "advance"
          }
        }
      },
      "then": {
        "required": [
          "gate",
          "expected_sha256",
          "note"
        ],
        "properties": {
          "allow_paid": {
            "const": false
          }
        },
        "not": {
          "required": [
            "operation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "reopen"
          }
        }
      },
      "then": {
        "required": [
          "gate",
          "expected_sha256",
          "note"
        ],
        "properties": {
          "allow_paid": {
            "const": false
          }
        },
        "not": {
          "required": [
            "operation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "freeze_preregistration"
          }
        }
      },
      "then": {
        "required": [
          "paper_id",
          "expected_sha256",
          "note"
        ],
        "properties": {
          "allow_paid": {
            "const": false
          }
        },
        "not": {
          "required": [
            "operation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "confirm_data_quality"
          }
        }
      },
      "then": {
        "required": [
          "dataset_id",
          "expected_sha256",
          "note"
        ],
        "properties": {
          "allow_paid": {
            "const": false
          }
        },
        "not": {
          "required": [
            "operation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "confirm_reproduction"
          }
        }
      },
      "then": {
        "required": [
          "paper_id",
          "expected_sha256",
          "note"
        ],
        "properties": {
          "allow_paid": {
            "const": false
          }
        },
        "not": {
          "required": [
            "operation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "screen_literature"
          }
        }
      },
      "then": {
        "required": [
          "receipt_id",
          "expected_sha256",
          "note",
          "included_work_ids",
          "exclusion_reasons"
        ],
        "properties": {
          "allow_paid": {
            "const": false
          }
        },
        "not": {
          "required": [
            "operation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "confirm_source_scope"
          }
        }
      },
      "then": {
        "required": [
          "source",
          "scope",
          "expected_sha256",
          "note"
        ],
        "properties": {
          "allow_paid": {
            "const": false
          }
        },
        "not": {
          "required": [
            "operation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "review_dossier"
          }
        }
      },
      "then": {
        "required": [
          "operation"
        ],
        "properties": {
          "allow_paid": {
            "const": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "ready"
                }
              }
            },
            "then": {
              "required": [
                "gate"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "approve"
                }
              }
            },
            "then": {
              "required": [
                "gate"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "advance"
                }
              }
            },
            "then": {
              "required": [
                "gate"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "reopen"
                }
              }
            },
            "then": {
              "required": [
                "gate"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "freeze_preregistration"
                }
              }
            },
            "then": {
              "required": [
                "paper_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "confirm_data_quality"
                }
              }
            },
            "then": {
              "required": [
                "dataset_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "confirm_reproduction"
                }
              }
            },
            "then": {
              "required": [
                "paper_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "screen_literature"
                }
              }
            },
            "then": {
              "required": [
                "receipt_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "confirm_source_scope"
                }
              }
            },
            "then": {
              "required": [
                "source",
                "scope"
              ]
            }
          }
        ]
      }
    }
  ]
}
