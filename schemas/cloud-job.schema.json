{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owner-requested cloud research job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "actor",
    "project",
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "action": {
      "enum": [
        "accept_route",
        "acceptance",
        "advance",
        "amend_operating_constraints",
        "approve",
        "approve_primary_retry",
        "approve_scope_amendment",
        "approve_supplemental",
        "authorize_budget",
        "authorize_data",
        "auxiliary",
        "bocha_jev_probe",
        "confirm_data_quality",
        "confirm_reproduction",
        "confirm_research_increment",
        "confirm_review_packet",
        "confirm_source_scope",
        "confirm_study_validation",
        "confirm_supplemental",
        "continuation",
        "cycle",
        "free_jev_probe",
        "freeze_preregistration",
        "init",
        "literature",
        "paperqa",
        "preflight",
        "ready",
        "reconcile_budget",
        "reconcile_relay_guard",
        "reopen",
        "resume",
        "retire_primary_plan",
        "retire_supplemental",
        "review_dossier",
        "routing_status",
        "screen_literature",
        "set_routing_profile",
        "start_revision",
        "status",
        "tooluniverse"
      ]
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "allow_paid": {
      "type": "boolean"
    },
    "live": {
      "type": "boolean"
    },
    "free_policy_checked_on": {
      "type": "string",
      "format": "date"
    },
    "new_ceiling_cny": {
      "type": "integer",
      "minimum": 1
    },
    "target_submission_ready_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "reservation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "actual_cost_cny": {
      "type": "number",
      "minimum": 0
    },
    "evidence_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "paper_count": {
      "const": 6
    },
    "context": {
      "type": "string",
      "maxLength": 4000
    },
    "stage": {
      "enum": [
        "intake",
        "topic-intelligence",
        "paper-architecture",
        "experiment-design",
        "experiment-execution",
        "writing-and-review",
        "auxiliary"
      ]
    },
    "corpus": {
      "type": "string",
      "maxLength": 250
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "settings": {
      "enum": [
        "fast",
        "medium",
        "high"
      ]
    },
    "request_file": {
      "type": "string",
      "maxLength": 250
    },
    "manifest": {
      "type": "string",
      "pattern": "^(data/manifests|evidence/auxiliary-jobs)/.+\\.json$"
    },
    "expected_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repair_note": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "operation": {
      "enum": [
        "advance",
        "amend_operating_constraints",
        "approve",
        "approve_primary_retry",
        "approve_scope_amendment",
        "approve_supplemental",
        "confirm_data_quality",
        "confirm_reproduction",
        "confirm_research_increment",
        "confirm_review_packet",
        "confirm_source_scope",
        "confirm_study_validation",
        "confirm_supplemental",
        "freeze_preregistration",
        "ready",
        "reconcile_relay_guard",
        "reopen",
        "retire_primary_plan",
        "retire_supplemental",
        "screen_literature",
        "start_revision"
      ]
    },
    "gate": {
      "enum": [
        "G0",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5"
      ]
    },
    "paper_id": {
      "type": "string",
      "pattern": "^(P[0-9]{2}|all)$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,100}$"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250
    },
    "scope": {
      "enum": [
        "full_text",
        "abstract",
        "excerpt",
        "metadata"
      ]
    },
    "note": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "included_work_ids": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "exclusion_reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
    },
    "expected_profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_file": {
      "type": "string",
      "pattern": "^evidence/routing-profiles/.+\\.json$",
      "maxLength": 250
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "task_kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "task_profile": {
      "type": "object",
      "description": "Validated by the native dynamic routing profile contract; never changes task risk or budget authority."
    },
    "judgments": {
      "type": "object"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "decision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    }
