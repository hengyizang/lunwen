{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/originality-audit.schema.json",
  "title": "Topic originality and doctoral-case audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "search_scope", "closest_prior_work", "novelty_claims", "patent_search", "doctoral_case", "reliability_strategy", "human_review_required"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["ready_for_review", "approved"]},
    "search_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["databases", "adjacent_fields", "query_families", "cutoff_date"],
      "properties": {
        "databases": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "adjacent_fields": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "query_families": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "cutoff_date": {"type": "string", "format": "date"}
      }
    },
    "closest_prior_work": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "publication_year", "primary_source_url", "overlap", "difference", "evidence_location"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "publication_year": {"type": "integer", "minimum": 1900, "maximum": 2100},
          "primary_source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "overlap": {"type": "string", "minLength": 1},
          "difference": {"type": "string", "minLength": 1},
          "evidence_location": {"type": "string", "minLength": 1}
        }
      }
    },
    "novelty_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim", "novelty_type", "evidence_ids", "counterevidence", "residual_risk"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "novelty_type": {"enum": ["theoretical", "methodological", "empirical", "dataset", "benchmark", "system", "application"]},
          "evidence_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "counterevidence": {"type": "string", "minLength": 1},
          "residual_risk": {"type": "string", "minLength": 1}
        }
      }
    },
    "patent_search": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["completed", "not_applicable"]},
        "databases": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "queries": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "justification": {"type": "string"}
      }
    },
    "doctoral_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unifying_thesis", "original_knowledge_contribution", "synthesis_beyond_individual_papers", "methodological_progression", "scope_boundaries", "examiner_challenges"],
      "properties": {
        "unifying_thesis": {"type": "string", "minLength": 1},
        "original_knowledge_contribution": {"type": "string", "minLength": 1},
        "synthesis_beyond_individual_papers": {"type": "string", "minLength": 1},
        "methodological_progression": {"type": "string", "minLength": 1},
        "scope_boundaries": {"type": "string", "minLength": 1},
        "examiner_challenges": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}}
      }
    },
    "reliability_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triangulation", "replication", "sensitivity_analysis", "negative_result_policy", "external_validity"],
      "properties": {
        "triangulation": {"type": "string", "minLength": 1},
        "replication": {"type": "string", "minLength": 1},
        "sensitivity_analysis": {"type": "string", "minLength": 1},
        "negative_result_policy": {"type": "string", "minLength": 1},
        "external_validity": {"type": "string", "minLength": 1}
      }
    },
    "human_review_required": {"const": true}
  }
}
