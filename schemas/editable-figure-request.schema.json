{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-bound native editable method-diagram export request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_spec", "expected_source_sha256", "formats", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "diagram_spec": {"type": "string", "minLength": 1},
    "expected_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "story_ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^reports/figure-story/[A-Za-z0-9][A-Za-z0-9_-]{0,63}\\.json$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "formats": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["svg", "pptx", "drawio"]}},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/evidence"}},
    "reference_notes": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/reference"}},
    "replace_expected_export_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "evidence": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "locator"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "locator": {"type": "string", "minLength": 1, "maxLength": 500}}},
    "reference": {"type": "object", "additionalProperties": false, "required": ["source_url", "purpose", "rights_status", "note"], "properties": {"source_url": {"type": "string", "pattern": "^https://", "maxLength": 2000}, "purpose": {"const": "layout_reference"}, "rights_status": {"enum": ["unverified", "verified"]}, "note": {"type": "string", "minLength": 1, "maxLength": 1000}}}
  }
}
