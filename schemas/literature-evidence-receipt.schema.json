{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/literature-evidence-receipt.schema.json",
  "title": "Executed literature-search evidence receipt",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "receipt_id", "mode", "provider", "provider_name", "query", "request_url", "requested_at", "completed_at", "status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "mode": {"enum": ["live_search", "citation_graph", "licensed_local_export"]},
    "provider": {"type": "string", "minLength": 1},
    "provider_name": {"type": "string", "minLength": 1},
    "query": {"type": "string", "minLength": 1},
    "request_url": {"type": "string", "pattern": "^https://"},
    "final_url": {"type": "string", "pattern": "^https://"},
    "requested_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["success", "failed"]},
    "result_count": {"type": "integer", "minimum": 0},
    "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "normalized_results_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_response_path": {"type": "string", "minLength": 1},
    "normalized_results_path": {"type": "string", "minLength": 1},
    "error": {"type": "string"}
  }
}
