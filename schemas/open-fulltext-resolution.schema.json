{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/open-fulltext-resolution.schema.json",
  "title": "Open full-text candidate resolution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "doi", "resolved_at", "status", "candidates", "provider_failures", "policy"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "doi": {"type": "string", "pattern": "^10\\.\\d{4,9}/"},
    "resolved_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["candidates_found", "no_verified_candidate"]},
    "candidates": {"type": "array", "items": {"type": "object", "required": ["source", "url", "open_access_asserted_by_provider", "license_verified", "download_authorized"], "properties": {"source": {"enum": ["OpenAlex", "Unpaywall", "Crossref"]}, "url": {"type": "string", "pattern": "^https://"}, "landing_url": {"type": ["string", "null"]}, "version": {"type": ["string", "null"]}, "license_claim": {"type": ["string", "null"]}, "host_type": {"type": ["string", "null"]}, "open_access_asserted_by_provider": {"type": "boolean"}, "license_verified": {"const": false}, "download_authorized": {"const": false}}}},
    "provider_failures": {"type": "array", "items": {"type": "object", "required": ["source", "error"]}},
    "policy": {"type": "object", "required": ["advisory_only", "license_and_terms_human_confirmation_required", "access_controls_must_not_be_bypassed", "publisher_or_library_entitlement_is_not_inferred"]}
  }
}
