{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic figure story candidate receipt",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "operation", "id", "paper_id", "status", "phase", "request", "request_sha256", "inputs", "implementation_sha256", "implementation", "visual_style", "manuscript_alignment", "checks", "limits"],
  "properties": {
    "schema_version": {"const": "1.0"}, "operation": {"const": "figure_story"}, "id": {"type": "string"}, "paper_id": {"type": "string", "pattern": "^P[0-9]{2}$"}, "status": {"const": "candidate"}, "phase": {"enum": ["planned", "observed"]},
    "request": {"type": "object"}, "request_sha256": {"$ref": "#/$defs/hash"}, "implementation_sha256": {"$ref": "#/$defs/hash"},
    "inputs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}}}},
    "implementation": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}}}},
    "visual_style": {"type": "object"}, "manuscript_alignment": {"enum": ["not_available", "source_locations_checked"]},
    "checks": {"type": "object", "additionalProperties": false, "required": ["actual_module_and_arrow_inventory", "located_text_quotes", "numeric_source_bindings", "gallery_metadata_bindings"], "properties": {"actual_module_and_arrow_inventory": {"const": true}, "located_text_quotes": {"const": true}, "numeric_source_bindings": {"const": true}, "gallery_metadata_bindings": {"const": true}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["scientific_approval", "semantic_alignment_requires_human_review", "reference_images_inspected", "external_results_reusable_as_our_results", "final_render_inspection_required", "paid_model_calls"], "properties": {"scientific_approval": {"const": false}, "semantic_alignment_requires_human_review": {"const": true}, "reference_images_inspected": {"const": false}, "external_results_reusable_as_our_results": {"const": false}, "final_render_inspection_required": {"const": true}, "paid_model_calls": {"const": 0}}}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
