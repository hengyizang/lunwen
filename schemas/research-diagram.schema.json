{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Typed scientific diagram source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "title", "caption", "alt_text", "claim_ids", "output_stem", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "type": {"enum": ["architecture", "workflow", "sequence", "dataflow", "lifecycle", "mechanism"]},
    "title": {"type": "string", "minLength": 1},
    "caption": {"type": "string", "minLength": 1},
    "alt_text": {"type": "string", "minLength": 1},
    "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "output_stem": {"type": "string", "pattern": "^papers/P[0-9]{2}/figures/[A-Za-z0-9_-]+$"},
    "nodes": {"type": "array", "minItems": 2, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"}, "label": {"type": "string", "minLength": 1, "maxLength": 80}, "note": {"type": "string"}, "layer": {"type": "integer", "minimum": 0, "maximum": 7}, "rank": {"type": "integer", "minimum": 0, "maximum": 7}}}},
    "edges": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "label": {"type": "string"}}}}
  }
}
