{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Located contribution detail within paper-facts claim_alignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "subject",
    "finding",
    "conditions",
    "scientific_answer",
    "fact_roles",
    "execution",
    "expectation_review"
  ],
  "properties": {
    "kind": {
      "enum": [
        "empirical",
        "meta-analysis",
        "theoretical",
        "qualitative"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "finding": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "conditions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "scientific_answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "fact_roles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "fact_id",
          "value"
        ],
        "properties": {
          "role": {
            "enum": [
              "finding",
              "magnitude",
              "uncertainty",
              "comparison",
              "heterogeneity",
              "bias",
              "proposition",
              "assumptions",
              "proof",
              "scope"
            ]
          },
          "fact_id": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          }
        }
      }
    },
    "execution": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "path",
          "sha256"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "expectation_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned_source",
        "planned_quote",
        "observed_status",
        "decision",
        "reason",
        "scope"
      ],
      "properties": {
        "planned_source": {
          "$ref": "#/$defs/binding"
        },
        "planned_quote": {
          "type": "string",
          "minLength": 1
        },
        "observed_status": {
          "enum": [
            "supported",
            "partially_supported",
            "not_supported",
            "contradicted",
            "inconclusive"
          ]
        },
        "decision": {
          "enum": [
            "retain",
            "narrow",
            "reframe",
            "unsupported"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
