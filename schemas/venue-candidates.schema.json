{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/venue-candidates.schema.json",
  "title": "Hash-bound per-paper venue candidate registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "generated_by", "jcr_export", "papers", "human_review_required"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "generated_by": {"const": "deterministic_local_control_plane"},
    "jcr_export": {"type": "object", "required": ["path", "sha256", "imported_by", "imported_at", "source_url", "row_count"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "imported_by": {"type": "string", "minLength": 1}, "imported_at": {"type": "string", "format": "date-time"}, "source_url": {"type": "string", "pattern": "^https://"}, "row_count": {"type": "integer", "minimum": 1}}},
    "papers": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["paper_id", "target_jcr_quartile", "candidates"], "properties": {"paper_id": {"type": "string", "pattern": "^P[0-9]{2}$"}, "target_jcr_quartile": {"enum": ["Q1", "Q2"]}, "selected_venue_id": {"type": ["string", "null"]}, "candidates": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["rank", "venue_id", "name", "issn", "category", "quartile", "impact_factor", "indexing", "jcr_year", "jcr_source_url", "official_guidelines_url", "policy_source_url", "article_type", "scope_fit", "fit_score", "selection_status", "source_row_sha256"], "properties": {"rank": {"type": "integer", "minimum": 1}, "venue_id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "name": {"type": "string", "minLength": 1}, "issn": {"type": "string", "minLength": 1}, "category": {"type": "string", "minLength": 1}, "quartile": {"enum": ["Q1", "Q2"]}, "impact_factor": {"type": "number", "exclusiveMinimum": 1}, "indexing": {"enum": ["SCI", "SCIE"]}, "jcr_year": {"type": "integer"}, "jcr_source_url": {"type": "string", "pattern": "^https://"}, "official_guidelines_url": {"type": "string", "pattern": "^https://"}, "policy_source_url": {"type": "string", "pattern": "^https://"}, "article_type": {"type": "string", "minLength": 1}, "scope_fit": {"type": "string", "minLength": 1}, "fit_score": {"type": "number", "minimum": 0, "maximum": 100}, "selection_status": {"enum": ["candidate", "selected", "fallback"]}, "source_row_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}}}},
    "human_review_required": {"const": true}
  }
}
