{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/publication-figure-spec.schema.json",
  "title": "Deterministic publication figure specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "data", "output_stem", "style", "formats", "dpi", "caption", "alt_text", "claim_ids", "panels"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "data": {"type": "string", "minLength": 1},
    "output_stem": {"type": "string", "pattern": "^papers/P[0-9]{2}/figures/"},
    "style": {"enum": ["technical", "minimal", "high-impact"]},
    "formats": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["png", "pdf", "svg"]}, "allOf": [{"contains": {"const": "pdf"}}, {"contains": {"const": "svg"}}]},
    "dpi": {"type": "integer", "minimum": 300},
    "caption": {"type": "string", "minLength": 1},
    "alt_text": {"type": "string", "minLength": 1},
    "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "columns": {"type": "integer", "minimum": 1, "maximum": 3},
    "width": {"type": "number", "minimum": 3, "maximum": 18},
    "height": {"type": "number", "minimum": 2.5, "maximum": 24},
    "source_data_export": {"type": "boolean", "description": "Explicit opt-in; only export data cleared for redistribution."},
    "panels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "xlabel", "ylabel"],
        "properties": {
          "kind": {"enum": ["line", "scatter", "bar", "heatmap", "forest", "box", "violin", "strip", "histogram", "density", "ecdf", "area", "stacked_bar", "dumbbell", "errorbar", "roc", "pr", "calibration", "confusion", "correlation", "volcano", "pca", "survival", "sankey", "raincloud", "hexbin", "qq", "funnel", "waterfall"]},
          "data": {"type": "string"},
          "title": {"type": "string"},
          "x": {"type": "string", "minLength": 1},
          "y": {"type": "string", "minLength": 1},
          "xlabel": {"type": "string", "minLength": 1},
          "ylabel": {"type": "string", "minLength": 1},
          "hue": {"type": "string"},
          "legend_title": {"type": "string"},
          "value": {"type": "string"},
          "label": {"type": "string"},
          "ci_low": {"type": "string"},
          "ci_high": {"type": "string"},
          "end": {"type": "string"},
          "bins": {"type": "integer", "minimum": 5, "maximum": 100},
          "threshold": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
          "effect_threshold": {"type": "number", "minimum": 0},
          "reference": {"type": "number"},
          "annotate": {"type": "boolean"},
          "colorbar_label": {"type": "string"},
          "x_tick_rotation": {"type": "number"},
          "uncertainty": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lower", "upper"],
            "properties": {"lower": {"type": "string"}, "upper": {"type": "string"}}
          }
        },
        "allOf": [
          {"if": {"properties": {"kind": {"const": "forest"}}}, "then": {"required": ["y", "label", "ci_low", "ci_high"]}},
          {"if": {"properties": {"kind": {"const": "correlation"}}}, "else": {"if": {"properties": {"kind": {"const": "forest"}}}, "else": {"required": ["x", "y"]}}},
          {"if": {"properties": {"kind": {"enum": ["heatmap", "confusion", "sankey"]}}}, "then": {"required": ["value"]}},
          {"if": {"properties": {"kind": {"const": "dumbbell"}}}, "then": {"required": ["end"]}},
          {"if": {"properties": {"kind": {"const": "errorbar"}}}, "then": {"required": ["uncertainty"]}}
        ]
      }
    }
  }
}
