{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/academic-style-audit.schema.json",
  "title": "Authentic academic style audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "status",
    "purpose",
    "detector_score_used",
    "detector_evasion_prohibited",
    "disclosure_must_be_preserved",
    "human_review_required",
    "manuscript",
    "analysis",
    "reviewed_rule_sources",
    "external_linters",
    "errors",
    "warnings",
    "note"
  ],
  "properties": {
    "schema_version": {"const": "1.2"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["pass", "revise"]},
    "purpose": {"const": "authentic_academic_style_and_readability"},
    "detector_score_used": {"const": false},
    "detector_evasion_prohibited": {"const": true},
    "disclosure_must_be_preserved": {"const": true},
    "human_review_required": {"const": true},
    "manuscript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source_tree_sha256"],
      "properties": {
        "path": {"type": ["string", "null"]},
        "source_tree_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "analysis": {
      "type": "object",
      "required": [
        "word_count",
        "sentence_count",
        "paragraph_count",
        "formulaic_pattern_findings",
        "formulaic_pattern_finding_count",
        "errors",
        "warnings"
      ],
      "properties": {
        "word_count": {"type": "integer", "minimum": 0},
        "sentence_count": {"type": "integer", "minimum": 0},
        "paragraph_count": {"type": "integer", "minimum": 0},
        "formulaic_pattern_findings": {"type": "array"},
        "formulaic_pattern_finding_count": {"type": "integer", "minimum": 0},
        "errors": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "reviewed_rule_sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "repository", "commit", "license", "use"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "format": "uri"},
          "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "upstream_version": {"type": "string"},
          "license": {"type": "string", "minLength": 1},
          "use": {"type": "string", "minLength": 1}
        }
      }
    },
    "external_linters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source",
          "license",
          "required",
          "local_only",
          "detector",
          "available",
          "status",
          "diagnostic_count",
          "diagnostics",
          "note"
        ],
        "properties": {
          "name": {"enum": ["proselint", "harper"]},
          "source": {
            "enum": [
              "https://github.com/amperser/proselint",
              "https://github.com/Automattic/harper"
            ]
          },
          "license": {"enum": ["BSD-3-Clause", "Apache-2.0"]},
          "required": {"const": false},
          "local_only": {"const": true},
          "detector": {"const": false},
          "available": {"type": "boolean"},
          "status": {"enum": ["pass", "advisory", "unavailable", "error"]},
          "diagnostic_count": {"type": "integer", "minimum": 0},
          "diagnostics": {"type": "array"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "note": {"type": "string", "minLength": 1}
  }
}
