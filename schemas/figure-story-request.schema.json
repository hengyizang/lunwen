{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-bound main-figure candidate brief",
  "description": "Planned and observed content remain distinct; static source checks grant no scientific approval.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "paper_id", "phase", "paper_contract", "claims", "diagram", "sources", "claim_ids", "gallery_report", "references", "problem", "contribution", "flow", "panels", "modules", "connections", "numeric_bindings", "result_sources"],
  "properties": {
    "schema_version": {"const": "1.0"}, "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "paper_id": {"type": "string", "pattern": "^P[0-9]{2}$"}, "phase": {"enum": ["planned", "observed"]},
    "paper_contract": {"$ref": "#/$defs/binding"}, "claims": {"$ref": "#/$defs/binding"}, "diagram": {"$ref": "#/$defs/binding"}, "manuscript": {"$ref": "#/$defs/binding"}, "gallery_report": {"$ref": "#/$defs/binding"},
    "sources": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/binding"}},
    "claim_ids": {"$ref": "#/$defs/ids"},
    "problem": {"$ref": "#/$defs/locatedText"}, "contribution": {"$ref": "#/$defs/locatedText"},
    "flow": {"type": "object", "additionalProperties": false, "required": ["inputs", "mechanisms", "outputs"], "properties": {"inputs": {"$ref": "#/$defs/ids"}, "mechanisms": {"$ref": "#/$defs/ids"}, "outputs": {"$ref": "#/$defs/ids"}}},
    "references": {"type": "array", "minItems": 2, "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["figure_id", "url", "metadata_sha256", "borrow_layout", "do_not_copy"], "properties": {"figure_id": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}, "metadata_sha256": {"$ref": "#/$defs/hash"}, "borrow_layout": {"$ref": "#/$defs/text"}, "do_not_copy": {"$ref": "#/$defs/text"}}}},
    "panels": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["id", "purpose", "node_ids", "claim_ids", "text_locator"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"}, "purpose": {"$ref": "#/$defs/text"}, "node_ids": {"$ref": "#/$defs/ids"}, "claim_ids": {"$ref": "#/$defs/ids"}, "text_locator": {"$ref": "#/$defs/anchor"}}}},
    "modules": {"type": "array", "minItems": 2, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["node_id", "meaning", "phase", "text_locator"], "properties": {"node_id": {"type": "string", "minLength": 1}, "meaning": {"$ref": "#/$defs/text"}, "phase": {"$ref": "#/$defs/contentPhase"}, "text_locator": {"$ref": "#/$defs/anchor"}}}},
    "connections": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["from", "to", "kind", "meaning", "phase", "text_locator"], "properties": {"from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}, "kind": {"enum": ["data", "control", "causal", "association", "feedback", "temporal"]}, "meaning": {"$ref": "#/$defs/text"}, "phase": {"$ref": "#/$defs/contentPhase"}, "text_locator": {"$ref": "#/$defs/anchor"}}}},
    "numeric_bindings": {"type": "array", "maxItems": 200, "items": {"type": "object", "additionalProperties": false, "required": ["value", "phase", "text_locator"], "properties": {"value": {"type": "string", "minLength": 1}, "phase": {"$ref": "#/$defs/contentPhase"}, "text_locator": {"$ref": "#/$defs/anchor"}}}},
    "result_sources": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "run_id"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}, "run_id": {"type": "string", "minLength": 1}}}}
  },
  "allOf": [{"if": {"properties": {"phase": {"const": "observed"}}}, "then": {"required": ["manuscript"], "properties": {"result_sources": {"minItems": 1}}}, "else": {"properties": {"result_sources": {"maxItems": 0}}}}],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "path": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1, "maxLength": 4000},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "contentPhase": {"enum": ["method", "planned", "observed"]},
    "binding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "anchor": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "start_line", "end_line", "quote", "kind"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}, "start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}, "quote": {"$ref": "#/$defs/text"}, "kind": {"enum": ["manuscript", "protocol", "paper_contract", "method", "result"]}}},
    "locatedText": {"type": "object", "additionalProperties": false, "required": ["text", "text_locator"], "properties": {"text": {"$ref": "#/$defs/text"}, "text_locator": {"$ref": "#/$defs/anchor"}}}
  }
}
