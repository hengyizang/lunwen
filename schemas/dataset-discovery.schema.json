{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/dataset-discovery.schema.json",
  "title": "Dataset discovery report",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "query",
    "providers",
    "candidate_count",
    "candidates",
    "warning"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "query": {"type": "string", "minLength": 1},
    "providers": {"type": "array", "items": {"type": "object"}},
    "candidate_count": {"type": "integer", "minimum": 0},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "provider_id",
          "title",
          "landing_url",
          "license_status",
          "fitness_status"
        ],
        "properties": {
          "provider": {"type": "string"},
          "provider_id": {"type": "string"},
          "title": {"type": "string"},
          "landing_url": {"type": "string", "pattern": "^https://"},
          "license_status": {"const": "unverified_requires_human_review"},
          "fitness_status": {
            "enum": [
              "candidate_only",
              "candidate_only_requires_scientific_and_human_review"
            ]
          },
          "metadata_relevance_score": {"type": "integer", "minimum": 0, "maximum": 100},
          "matched_queries": {"type": "array", "items": {"type": "string"}},
          "also_found_by": {"type": "array", "items": {"type": "string"}},
          "screening_reasons": {"type": "array", "items": {"type": "string"}},
          "automatic_screening": {
            "type": "object",
            "required": [
              "rank",
              "status",
              "metadata_score",
              "scientific_fitness_assessed"
            ],
            "properties": {
              "rank": {"type": "integer", "minimum": 1},
              "status": {"enum": ["metadata_shortlist", "metadata_deprioritized"]},
              "metadata_score": {"type": "integer", "minimum": 0, "maximum": 100},
              "cross_source_count": {"type": "integer", "minimum": 0},
              "persistent_identifier_present": {"type": "boolean"},
              "license_metadata_present_unverified": {"type": "boolean"},
              "version_metadata_present": {"type": "boolean"},
              "scientific_fitness_assessed": {"const": false}
            }
          }
        }
      }
    },
    "automatic_screening_summary": {
      "type": "object",
      "required": [
        "method",
        "minimum_metadata_score",
        "shortlist_count",
        "not_automatically_decided",
        "human_review_required"
      ],
      "properties": {
        "method": {"const": "deterministic_metadata_screening"},
        "minimum_metadata_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "maximum_shortlist": {"type": "integer", "minimum": 1},
        "shortlist_count": {"type": "integer", "minimum": 0},
        "deprioritized_count": {"type": "integer", "minimum": 0},
        "shortlisted_candidate_ids": {"type": "array", "items": {"type": "string"}},
        "criteria": {"type": "array", "items": {"type": "string"}},
        "not_automatically_decided": {"type": "array", "items": {"type": "string"}},
        "human_review_required": {"const": true}
      }
    },
    "warning": {"type": "string"}
  }
}
