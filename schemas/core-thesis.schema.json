{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/core-thesis.schema.json",
  "title": "Doctoral core theme A",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "theme_id", "status", "title", "doctoral_question", "distinct_contribution", "novelty_claim_ids", "planned_paper_ids", "falsification_conditions", "human_review_required"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "theme_id": {"const": "A"},
    "status": {"enum": ["ready_for_review", "approved"]},
    "title": {"type": "string", "minLength": 1},
    "doctoral_question": {"type": "string", "minLength": 1},
    "distinct_contribution": {"type": "string", "minLength": 1},
    "novelty_claim_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "planned_paper_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^P[0-9]{2}$"}},
    "falsification_conditions": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "human_review_required": {"const": true}
  }
}
