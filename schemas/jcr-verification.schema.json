{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "database", "verification_year", "impact_factor", "quartile", "category", "indexing", "source_url", "verified_by", "verified_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "database": {"const": "Clarivate Journal Citation Reports"},
    "verification_year": {"type": "integer", "minimum": 2000},
    "impact_factor": {"type": "number", "exclusiveMinimum": 1.0},
    "quartile": {"enum": ["Q1", "Q2", "Q3", "Q4"]},
    "category": {"type": "string", "minLength": 1},
    "indexing": {"enum": ["SCIE", "SCI"]},
    "source_url": {"type": "string", "pattern": "^https://"},
    "verified_by": {"type": "string", "minLength": 1},
    "verified_at": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
