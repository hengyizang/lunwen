{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hengyizang/lunwen/schemas/experiment-plan.schema.json",
  "title": "Approved experiment execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "runs"],
  "properties": {
    "schema_version": {"type": "string"},
    "status": {"const": "ready_for_review"},
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "paper_id",
          "argv",
          "cwd",
          "seed",
          "timeout_seconds",
          "estimated_cost_usd",
          "inputs",
          "expected_outputs"
        ],
        "properties": {
          "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
          "paper_id": {"type": "string", "pattern": "^P[0-9]{2}$"},
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "cwd": {"type": "string", "minLength": 1},
          "seed": {"type": "integer"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
          "estimated_cost_usd": {"type": "number", "minimum": 0},
          "expected_outputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
